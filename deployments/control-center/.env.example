# Copy to .env and replace every value. Do not commit .env.
# Passwords used in DB_URL must be URL-safe.
DEVLAKE_MYSQL_ROOT_PASSWORD=replace-with-a-long-random-root-password
DEVLAKE_DB_PASSWORD=replace-with-a-url-safe-random-database-password
DEVLAKE_ENCRYPTION_SECRET=replace-with-a-stable-random-encryption-secret
DEVLAKE_ADMIN_USER=devlake-admin
DEVLAKE_ADMIN_PASSWORD=replace-with-a-long-random-config-ui-password
GRAFANA_ADMIN_USER=dsbot-admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-grafana-password
