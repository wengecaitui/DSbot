{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/wengecaitui/DSbot/security/audit-exceptions.schema.json",
  "title": "Audit Exception Registry",
  "description": "Time-bounded security audit exception registry for audit-ci allowlist entries.",
  "type": "object",
  "required": ["exceptions"],
  "properties": {
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["advisoryId", "package", "severity", "reason", "owner", "createdAt", "expiresAt", "maximumLifetimeDays", "compensatingControls", "removalCondition", "dependencyFingerprint"],
        "properties": {
          "advisoryId": { "type": "string", "pattern": "^GHSA-[a-z0-9]{4}-[a-z0-9]{4}-[a-z0-9]{4}$" },
          "package": { "type": "string", "minLength": 1 },
          "relatedCves": { "type": "array", "items": { "type": "string", "pattern": "^CVE-\\d{4}-\\d+$" } },
          "severity": { "type": "string", "enum": ["low", "moderate", "high", "critical"] },
          "reason": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 1 },
          "createdAt": { "type": "string", "format": "date" },
          "expiresAt": { "type": "string", "format": "date" },
          "maximumLifetimeDays": { "type": "integer", "minimum": 1, "maximum": 30 },
          "compensatingControls": { "type": "array", "items": { "type": "string" } },
          "removalCondition": { "type": "string", "minLength": 1 },
          "dependencyFingerprint": {
            "type": "object",
            "additionalProperties": false,
            "required": ["topology"],
            "properties": {
              "topology": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["packageName", "packagePath", "version", "consumers"],
                  "properties": {
                    "packageName": { "type": "string", "minLength": 1 },
                    "packagePath": { "type": "string", "pattern": "^node_modules/" },
                    "version": { "type": "string", "minLength": 1 },
                    "consumers": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["path", "version", "dependencyType", "dependencySpecifier"],
                        "properties": {
                          "path": { "type": "string", "pattern": "^node_modules/" },
                          "version": { "type": "string", "minLength": 1 },
                          "dependencyType": { "type": "string", "enum": ["dependencies", "optionalDependencies"] },
                          "dependencySpecifier": { "type": "string", "minLength": 1 }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
